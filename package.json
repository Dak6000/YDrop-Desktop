{
  "name": "ydrop",
  "version": "1.1.0",
  "description": "YDrop — Téléchargeur YouTube & créateur de vidéos courtes (TikTok, Reels, Shorts)",
  "author": "DJADJARO Abdoul Khabirou",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "release:win": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.ydrop",
    "productName": "YDrop",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YDrop"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Dak6000",
        "repo": "YDrop-Desktop",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Dak6000/YDrop-Desktop.git"
  }
}
